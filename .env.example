# --- Gateway (apps/gateway) ---

# development | staging | production
ENVIRONMENT=development
PORT=8787

# PostgreSQL connection string
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway

# Secret used to sign JWTs. MUST be >= 32 random characters in production.
JWT_SECRET=change-me-to-a-long-random-string

# Public base URL of the gateway (used in OAuth discovery)
JWT_ISSUER=http://localhost:8787

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Service token protecting /admin/api/* (required in production).
# The dashboard uses this to talk to the gateway.
ADMIN_TOKEN=change-me-admin-token

# Default tenant for single-tenant deployments
TENANT_ID=default

# --- Dashboard (apps/dashboard) ---

# Where the dashboard reaches the gateway (server-side)
GATEWAY_URL=http://localhost:8787
# Same value as ADMIN_TOKEN above
GATEWAY_ADMIN_TOKEN=change-me-admin-token

# better-auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Allow new sign-ups (turn off after creating the first admin account)
DASHBOARD_ALLOW_SIGNUP=true
