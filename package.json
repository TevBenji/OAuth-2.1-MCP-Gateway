{
  "name": "oauth-mcp-gateway",
  "version": "1.0.0",
  "description": "OAuth 2.1 authentication gateway for MCP servers",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc && wrangler publish --dry-run",
    "deploy": "wrangler publish",
    "deploy:staging": "wrangler publish --env staging",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:integration:e2e": "vitest run tests/integration/end-to-end-oauth-flow.test.ts",
    "test:integration:isolation": "vitest run tests/integration/multi-tenant-isolation.test.ts",
    "test:security": "vitest run tests/security",
    "test:security:pkce": "vitest run tests/security/pkce-security.test.ts",
    "test:security:tokens": "vitest run tests/security/token-validation-security.test.ts",
    "test:performance": "vitest run tests/performance",
    "test:performance:load": "vitest run tests/performance/load-testing.test.ts",
    "test:chaos": "vitest run tests/chaos",
    "test:chaos:failures": "vitest run tests/chaos/failure-scenarios.test.ts",
    "test:deployment": "vitest run tests/deployment",
    "test:smoke": "vitest run tests/deployment/smoke-tests.test.ts",
    "test:suite": "vitest run tests/integration/test-runner.ts",
    "test:comprehensive": "vitest run tests/integration/comprehensive-test-suite.test.ts",
    "test:real-mcp": "vitest run tests/integration/real-mcp-server.test.ts",
    "test:security:comprehensive": "vitest run tests/security/comprehensive-security.test.ts",
    "test:pre-deploy": "npm run lint && npm run type-check && npm run test",
    "type-check": "tsc --noEmit --project tsconfig.tests.json",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:neon": "node scripts/migrate-neon.js",
    "db:seed": "node scripts/seed.js",
    "infrastructure": "node scripts/infrastructure.js",
    "monitoring": "node scripts/monitoring.js",
    "verify": "node scripts/verify-deployment.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "hono": "^3.12.0",
    "jose": "^5.2.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "vitest-environment-miniflare": "^2.14.4",
    "wrangler": "^3.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
