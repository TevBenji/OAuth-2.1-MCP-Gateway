// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - integrates with Clerk
model User {
  id               String           @id @default(cuid())
  clerkId          String           @unique
  email            String           @unique
  name             String?
  avatarUrl        String?
  role             UserRole         @default(USER)

  // Organization
  organizationId   String?
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  ownedOrgs        Organization[]   @relation("OrganizationOwner")

  // Subscription
  subscription     Subscription?

  // API Keys
  apiKeys          ApiKey[]

  // Usage & Billing
  usageRecords     UsageRecord[]
  billingInfo      BillingInfo?
  invoices         Invoice[]
  payments         Payment[]

  // Activity
  lastActiveAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([clerkId])
  @@index([email])
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// Organization for team/enterprise accounts
model Organization {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String?
  logo             String?

  // Owner
  ownerId          String
  owner            User             @relation("OrganizationOwner", fields: [ownerId], references: [id])

  // Members
  members          User[]

  // Subscription
  subscription     Subscription?

  // Projects & API Keys
  projects         Project[]

  // Settings
  settings         Json?
  metadata         Json?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([slug])
}

// Projects within an organization
model Project {
  id               String           @id @default(cuid())
  name             String
  description      String?

  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])

  // API Keys for this project
  apiKeys          ApiKey[]

  // OAuth configurations
  oauthConfigs     OAuthConfig[]

  // Settings
  settings         Json?
  metadata         Json?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizationId])
}

// Subscription model
model Subscription {
  id               String           @id @default(cuid())

  // Relations
  userId           String?          @unique
  user             User?            @relation(fields: [userId], references: [id])

  organizationId   String?          @unique
  organization     Organization?    @relation(fields: [organizationId], references: [id])

  // Stripe
  stripeCustomerId String?          @unique
  stripeSubscriptionId String?      @unique
  stripePriceId    String?
  stripeCurrentPeriodEnd DateTime?

  // Plan details
  plan             PlanType         @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)

  // Limits
  apiCallLimit     Int              @default(1000)
  apiCallsUsed     Int              @default(0)
  projectLimit     Int              @default(1)
  teamMemberLimit  Int              @default(1)

  // Billing cycle
  billingCycle     BillingCycle     @default(MONTHLY)
  nextBillingDate  DateTime?
  cancelAt         DateTime?
  canceledAt       DateTime?

  // Trial
  trialEnd         DateTime?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

enum PlanType {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  PAUSED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// API Keys
model ApiKey {
  id               String           @id @default(cuid())
  name             String
  key              String           @unique
  hashedKey        String?          @unique
  prefix           String?

  // Relations
  userId           String
  user             User             @relation(fields: [userId], references: [id])

  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id])

  // Permissions
  scopes           String[]
  rateLimit        Int              @default(100)

  // Usage
  lastUsedAt       DateTime?
  usageCount       Int              @default(0)

  // Status
  isActive         Boolean          @default(true)
  expiresAt        DateTime?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([key])
  @@index([hashedKey])
  @@index([userId])
  @@index([projectId])
}

// OAuth Configuration for MCP
model OAuthConfig {
  id               String           @id @default(cuid())

  projectId        String
  project          Project          @relation(fields: [projectId], references: [id])

  // OAuth Provider Details
  provider         String
  clientId         String
  clientSecret     String           // Should be encrypted
  redirectUri      String
  scopes           String[]

  // MCP Server Details
  mcpServerUrl     String
  mcpServerName    String

  // Settings
  isActive         Boolean          @default(true)
  settings         Json?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([projectId])
  @@unique([projectId, provider])
}

// Usage tracking
model UsageRecord {
  id               String           @id @default(cuid())

  userId           String
  user             User             @relation(fields: [userId], references: [id])

  // What was used
  resource         String           // e.g., "api_call", "oauth_auth", "mcp_request"
  operation        String?          // e.g., "create_token", "refresh_token"

  // Metrics
  count            Int              @default(1)
  responseTime     Int?             // in milliseconds
  dataTransferred  Int?             // in bytes

  // Status
  status           String           // "success", "error", "rate_limited"
  errorMessage     String?

  // Metadata
  metadata         Json?
  ipAddress        String?
  userAgent        String?

  timestamp        DateTime         @default(now())

  @@index([userId, timestamp])
  @@index([resource])
}

// Billing Information
model BillingInfo {
  id               String           @id @default(cuid())

  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])

  // Billing Address
  fullName         String?
  companyName      String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?

  // Tax
  taxId            String?
  vatNumber        String?

  // Payment Method (Stripe)
  stripePaymentMethodId String?
  cardLast4        String?
  cardBrand        String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// Invoices
model Invoice {
  id               String           @id @default(cuid())

  userId           String
  user             User             @relation(fields: [userId], references: [id])

  // Invoice details
  invoiceNumber    String           @unique
  stripeInvoiceId  String?          @unique

  // Amounts (in cents)
  subtotal         Int
  tax              Int              @default(0)
  total            Int
  currency         String           @default("usd")

  // Status
  status           InvoiceStatus    @default(DRAFT)

  // Dates
  billingPeriodStart DateTime
  billingPeriodEnd DateTime
  dueDate          DateTime?
  paidAt           DateTime?

  // PDF/Receipt
  receiptUrl       String?
  pdfUrl           String?

  // Line items stored as JSON
  lineItems        Json

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([invoiceNumber])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

// Payment records
model Payment {
  id               String           @id @default(cuid())

  userId           String
  user             User             @relation(fields: [userId], references: [id])

  // Payment details
  stripePaymentIntentId String?      @unique
  amount           Int              // in cents
  currency         String           @default("usd")

  // Status
  status           PaymentStatus    @default(PENDING)

  // Method
  paymentMethod    String?          // e.g., "card", "bank_transfer"
  last4            String?

  // Metadata
  description      String?
  metadata         Json?

  // Failure info
  failureReason    String?
  failureCode      String?

  processedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([stripePaymentIntentId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Vouchers/Promo codes
model Voucher {
  id               String           @id @default(cuid())
  code             String           @unique
  description      String?

  // Discount
  discountType     DiscountType     @default(PERCENTAGE)
  discountValue    Int              // percentage (0-100) or amount in cents

  // Validity
  validFrom        DateTime         @default(now())
  validUntil       DateTime?
  maxUses          Int?
  currentUses      Int              @default(0)

  // Restrictions
  planRestrictions PlanType[]
  minPurchaseAmount Int?            // in cents

  isActive         Boolean          @default(true)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([code])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Export records for compliance
model ExportRecord {
  id               String           @id @default(cuid())

  userId           String
  type             String           // e.g., "gdpr_data", "usage_report", "invoices"
  status           ExportStatus     @default(PENDING)

  // File info
  fileUrl          String?
  fileSize         Int?             // in bytes
  expiresAt        DateTime?

  // Processing
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}
